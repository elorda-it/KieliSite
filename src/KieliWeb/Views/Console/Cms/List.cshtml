@using KieliWeb.Setup.Cms
@{
    EntityDef def = QarModel<EntityDef>("entity");
    (string Value, string Label)[] filterOptions = QarModel<(string, string)[]>("filterOptions") ?? Array.Empty<(string, string)>();
    string filterValue = def.Filter == null ? string.Empty : Context.Request.Query[def.Filter.QueryKey].ToString();
    string baseUrl = $"/{CurrentLanguage}/{def.Controller.ToLower()}/{def.Action.ToLower()}";
}
<section class="pc-container">
    <div class="pc-content">
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <div class="col-md-12">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="javascript:void(0)">@def.Group</a></li>
                            <li class="breadcrumb-item" aria-current="page">@def.Title</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <h5 class="mb-0">@def.Title</h5>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    @if (def.Filter != null)
                    {
                        <select class="form-select" id="kf-filter" data-plain aria-label="@def.Filter.Label" style="min-width:220px">
                            <option value="">@def.Filter.Label: барлығы</option>
                            @foreach ((string v, string label) in filterOptions)
                            {
                                <option value="@v" selected="@(v == filterValue)">@label</option>
                            }
                        </select>
                    }
                    @if (def.ListCommand is (string commandLabel, string commandIcon) && CanEdit)
                    {
                        <button type="button" class="btn btn-outline-secondary d-inline-flex" id="kf-command" data-loading-text="@commandLabel…"><i class="@commandIcon me-1"></i> @commandLabel</button>
                    }
                    @if (CanCreate && def.CanCreate)
                    {
                        <a href="@baseUrl/create" class="btn btn-outline-primary d-inline-flex" id="kf-create"><i class="ti ti-circle-plus me-1"></i> Қосу</a>
                    }
                    @if (CanDelete && def.Table != "region")
                    {
                        <button type="button" class="btn btn-outline-danger d-inline-flex"
                            data-qar-tableid="qar-table"
                            data-qar-confirm="/@(CurrentLanguage)/@(def.Controller)/Set@(def.Action)Status"
                            data-qar-ok="@(T("ls_Yes"))" data-qar-cancel="@(T("ls_No"))"
                            data-qar-title="Белгіленген жолдарды өшіресіз бе?">
                            <i class="ti ti-trash me-1"></i> Белгіленгенді өшіру
                        </button>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(def.Help))
                {
                    <div class="alert alert-light-primary kf-help">@def.Help</div>
                }
                <div class="dt-responsive">
                    <table id="qar-table" class="table table-striped table-bordered align-middle" style="width:100%">
                        <thead>
                            <tr>
                                <th>
                                    <div class="form-check abc-checkbox">
                                        <input class="form-check-input datatable-checkbox-all" type="checkbox" aria-label="Барлығын белгілеу">
                                    </div>
                                </th>
                                @foreach (ColumnDef c in def.Columns)
                                {
                                    <th>@c.Title</th>
                                }
                                @if (def.Translatable)
                                {
                                    <th>Аударма</th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
<script>
  $(function () {
    var filter = document.getElementById("kf-filter");
    var table = $("#qar-table").DataTable({
      dom: "<'row'<'col-6'l><'col-6'f>><'row dt-row'<'col-sm-12'tr>><'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
      autoWidth: false, processing: true, serverSide: true, pageLength: 25, order: [],
      ajax: function (data, callback) {
        $.ajax({
          url: "/@(CurrentLanguage)/@(def.Controller)/Get@(def.Action)List", type: "POST",
          data: { keyword: data.search.value, start: data.start, length: data.length, orderList: data.order, filter: filter ? filter.value : "" },
          success: function (res) {
            var d = res.data || {}, total = parseInt(d.total || 0, 10);
            if (res.status !== "success") $qar.showMessage("error", res.message);
            callback({ data: total > 0 ? d.dataList : [], recordsFiltered: total, recordsTotal: total });
          }
        });
      },
      columns: [
        { data: null, orderable: false, width: "20px", render: function (d, t, row) {
            return '<div class="form-check abc-checkbox"><input id="cb' + row.id + '" data-id="' + row.id + '" class="form-check-input datatable-checkbox" type="checkbox"></div>'; } },
        @for (int i = 0; i < def.Columns.Length; i++)
        {
        <text>{ data: "c@(i)", orderable: @(def.Columns[i].SortSql != null ? "true" : "false") },</text>
        }
        @if (def.Translatable)
        {
        <text>{ data: "tr", orderable: false, width: "130px" },</text>
        }
        { data: null, orderable: false, width: "90px", render: function (d, t, row) {
            return '<div class="d-flex gap-1"><a class="btn btn-icon btn-outline-secondary" title="Өңдеу" href="@(baseUrl)/edit?id=' + row.id + '"><i class="ti ti-edit"></i></a>' +
              (row.url ? '<a class="btn btn-icon btn-outline-secondary" title="Сайтта көру" target="_blank" rel="noopener" href="' + $('<i>').text(row.url).html() + '"><i class="ti ti-external-link"></i></a>' : '') + '</div>'; } }
      ],
      oLanguage: $qar.getDataTableLanguage()
    });
    if (filter) filter.addEventListener("change", function () {
      var url = new URL(location.href);
      if (filter.value) url.searchParams.set("@(def.Filter?.QueryKey)", filter.value); else url.searchParams.delete("@(def.Filter?.QueryKey)");
      history.replaceState(null, "", url);
      var create = document.getElementById("kf-create");
      if (create) create.href = "@(baseUrl)/create" + (filter.value ? "?@(def.Filter?.QueryKey)=" + filter.value : "");
      table.ajax.reload();
    });
    if (filter && filter.value) filter.dispatchEvent(new Event("change"));
    /* the list's own command (EntityDef.ListCommand): run=1 to the save address, then show what it did */
    var command = document.getElementById("kf-command");
    if (command) command.addEventListener("click", function () {
      var data = new FormData(), label = command.innerHTML;
      data.append("id", "-1");
      data.append("run", "1");
      command.disabled = true;
      command.textContent = command.getAttribute("data-loading-text");
      fetch("/@(CurrentLanguage)/@(def.Controller)/@(def.Action)", { method: "POST", body: data }).then(function (r) { return r.json(); }).then(function (res) {
        $qar.showMessage(res.status, res.message);
        table.ajax.reload(null, false);
      }).catch(function (err) { $qar.showMessage("error", err.message); }).then(function () {
        command.disabled = false;
        command.innerHTML = label;
      });
    });
  });
</script>
}
