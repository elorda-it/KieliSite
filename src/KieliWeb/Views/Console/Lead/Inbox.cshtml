@{
    int newCount = QarInt("newCount");
}
<section class="pc-container">
    <div class="pc-content">
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <div class="col-md-12">
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="javascript:void(0)">Өтінімдер</a></li>
                            <li class="breadcrumb-item" aria-current="page">Кеңес өтінімдері</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <h5 class="mb-0">Кеңес өтінімдері @if (newCount > 0) {<span class="badge bg-danger ms-2">@newCount жаңа</span>}</h5>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <select class="form-select" id="kf-filter" data-plain aria-label="Күйі" style="min-width:200px">
                        <option value="">Барлық өтінім</option>
                        @foreach ((byte v, string label, string _) in KieliWeb.Controllers.LeadController.Statuses)
                        {
                            <option value="@v" selected="@(v == 0 && newCount > 0)">@label</option>
                        }
                    </select>
                    @if (CanDelete)
                    {
                        <button type="button" class="btn btn-outline-danger d-inline-flex"
                            data-qar-tableid="qar-table" data-qar-confirm="/@(CurrentLanguage)/Lead/SetInboxStatus"
                            data-qar-ok="@(T("ls_Yes"))" data-qar-cancel="@(T("ls_No"))" data-qar-title="Белгіленген өтінімдерді өшіресіз бе?">
                            <i class="ti ti-trash me-1"></i> Белгіленгенді өшіру
                        </button>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="alert alert-light-primary kf-help">Сайттағы «Кеңес алу» терезесінен және басты беттегі формадан келген өтінімдер. Ашып, күйін («Жұмыста», «Аяқталды») белгілеңіз және ескертпе жазыңыз — оны тек әкімшілер көреді.</div>
                <div class="dt-responsive">
                    <table id="qar-table" class="table table-striped table-bordered align-middle" style="width:100%">
                        <thead>
                            <tr>
                                <th><div class="form-check abc-checkbox"><input class="form-check-input datatable-checkbox-all" type="checkbox" aria-label="Барлығын белгілеу"></div></th>
                                <th>Нөмірі</th><th>Кім</th><th>Қызмет</th><th>Қай елде · тілі</th><th>Файл</th><th>Күйі</th><th></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
<script>
  $(function () {
    var filter = document.getElementById("kf-filter");
    var table = $("#qar-table").DataTable({
      dom: "<'row'<'col-6'l><'col-6'f>><'row dt-row'<'col-sm-12'tr>><'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
      autoWidth: false, processing: true, serverSide: true, pageLength: 25, order: [],
      ajax: function (data, callback) {
        $.ajax({
          url: "/@(CurrentLanguage)/Lead/GetInboxList", type: "POST",
          data: { keyword: data.search.value, start: data.start, length: data.length, filter: filter.value },
          success: function (res) {
            var d = res.data || {}, total = parseInt(d.total || 0, 10);
            if (res.status !== "success") $qar.showMessage("error", res.message);
            callback({ data: total > 0 ? d.dataList : [], recordsFiltered: total, recordsTotal: total });
          }
        });
      },
      columns: [
        { data: null, orderable: false, width: "20px", render: function (d, t, row) { return '<div class="form-check abc-checkbox"><input data-id="' + row.id + '" class="form-check-input datatable-checkbox" type="checkbox"></div>'; } },
        { data: "c0", orderable: false }, { data: "c1", orderable: false }, { data: "c2", orderable: false },
        { data: "c3", orderable: false }, { data: "c4", orderable: false }, { data: "c5", orderable: false },
        { data: null, orderable: false, width: "50px", render: function (d, t, row) { return '<a class="btn btn-icon btn-outline-secondary" title="Ашу" href="/@(CurrentLanguage)/lead/inbox/edit?id=' + row.id + '"><i class="ti ti-eye"></i></a>'; } }
      ],
      oLanguage: $qar.getDataTableLanguage()
    });
    filter.addEventListener("change", function () { table.ajax.reload(); });
  });
</script>
}
