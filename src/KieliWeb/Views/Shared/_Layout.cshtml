<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"]) - KieliWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KieliWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header b-xhbb5ohxw0>
        <nav b-xhbb5ohxw0 class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div b-xhbb5ohxw0 class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">KieliWeb</a>
                <button b-xhbb5ohxw0 class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span b-xhbb5ohxw0 class="navbar-toggler-icon"></span>
                </button>
                <div b-xhbb5ohxw0 class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul b-xhbb5ohxw0 class="navbar-nav flex-grow-1">
                        <li b-xhbb5ohxw0 class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li b-xhbb5ohxw0 class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div b-xhbb5ohxw0 class="container">
        <main b-xhbb5ohxw0 role="main" class="pb-3">
            @(RenderBody())
        </main>
    </div>

    <footer b-xhbb5ohxw0 class="border-top footer text-muted">
        <div b-xhbb5ohxw0 class="container">
            &copy; 2026 - KieliWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @(await RenderSectionAsync("Scripts", required: false))
</body>
</html>
