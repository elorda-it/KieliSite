<main id="main">
  <section class="section">
    <div class="wrap" style="max-width:640px;text-align:center;padding-block:64px">
      <p class="eyebrow">404</p>
      <h1 class="page-title">@U("common.notFoundTitle")</h1>
      <p class="lead" style="margin-block:16px 28px">@U("common.notFoundText")</p>
      <p><a class="btn btn--primary" href="@L("/")">@U("common.notFoundHome")</a> <button type="button" class="btn btn--ghost" data-consult>@Block("site.consult")["title"]</button></p>
    </div>
  </section>
</main>
