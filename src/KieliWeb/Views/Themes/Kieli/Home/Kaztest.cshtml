@{
    BlockContent head = Block("kaztest.head");
    BlockContent law = Block("kaztest.law");
    BlockContent list = Block("kaztest.list");
    BlockContent how = Block("kaztest.how");
    string crumb = Block("site.nav").List("items").FirstOrDefault(i => i["key"] == "kaztest")?["label"] ?? "ҚАЗТЕСТ";
}
<main id="main">
  <section class="page-head kt-head">
    <div class="wrap">
      <ol class="crumbs" aria-label="@U("common.crumbs")"><li><a href="@L("/")">@U("common.home")</a></li><li>@crumb</li></ol>
      <div class="service-head">
        <div>
          <p class="eyebrow">@head["eyebrow"]</p>
          <h1 class="page-title">@head["title"]</h1>
          <p class="lead">@head["lead"]</p>
          <ul class="kt-facts">
@foreach (BlockContent f in head.List("facts"))
{
            <li>@Icon(f["icon"])<b>@f["title"]</b><span>@f["text"]</span></li>
}
          </ul>
        </div>
        <div class="service-head__cta">
          <a class="btn btn--sun" href="#nusqalar">@head["ctaChoose"]</a>
@if (head.Has("ctaCourse"))
{
          <button type="button" class="btn btn--ghost" data-consult="@head["ctaCourseService"]">@head["ctaCourse"]</button>
}
          <p>@head["ctaNote"]</p>
        </div>
      </div>
    </div>
  </section>

@if (law.Has("title"))
{
  <section class="section section--tight" style="padding-block-start:0" aria-labelledby="law-title">
    <div class="wrap">
      <div class="kt-law">
        <span class="kt-law__ic"><svg aria-hidden="true"><use href="#i-shield"/></svg></span>
        <div class="kt-law__body">
          <p class="eyebrow">@law["eyebrow"]</p>
          <h2 id="law-title">@law["title"]</h2>
          <p>@law["text"]</p>
@if (law.Has("sources"))
{
          <p class="kt-law__src">@law.Raw("sources")</p>
}
        </div>
      </div>
    </div>
  </section>
}

  <section class="section" id="nusqalar" aria-labelledby="nusqa-title" style="padding-block-start:0">
    <div class="wrap">
      <partial name="~/Views/Themes/Kieli/Shared/_SecHead.cshtml" model='new SectionModel(list, TitleId: "nusqa-title")' />
      <div data-kaztest><p class="empty">@U("kaztest.noJs")</p></div>
@if (list.Has("note"))
{
      <p class="help-foot">@list["note"]</p>
}
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="how-title">
    <div class="wrap">
      <partial name="~/Views/Themes/Kieli/Shared/_SecHead.cshtml" model='new SectionModel(how, TitleId: "how-title")' />
      <ol class="route route--4">
@{ int n = 0; }
@foreach (BlockContent s in how.List("steps"))
{
        n++;
        <li class="route__step"><span class="route__n">@n</span><h3 class="route__t">@s["title"]</h3><p class="route__d">@s["text"]</p></li>
}
      </ol>
    </div>
  </section>

  <partial name="~/Views/Themes/Kieli/Shared/_Faq.cshtml" model='new SectionModel(Block("kaztest.faq"), "section", "kt-faq-title")' />

  <partial name="~/Views/Themes/Kieli/Shared/_Cross.cshtml" model='Block("kaztest.cross")' />
</main>
@section Scripts {
<script>window.KAZTEST = @Html.Raw(ContentStore.KaztestJson(Cache, Block("kaztest.list"), Lang)); window.KIELI_UI_KAZTEST = @Html.Raw(ContentStore.UiJson(Cache, Lang, "kaztest"));</script>
<script src="@Asset("/kieli/js/kaztest.js")"></script>
}
